[Unit]
Description=HAPYCH Voice owner-only browser studio
After=network-online.target hapych-factory-tts.service
Wants=network-online.target

[Service]
Type=simple
User=sentinelx
Group=sentinelx
WorkingDirectory=/opt/hapych-factory-voice
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/opt/hapych-factory-voice/private/owner-tts.env
ExecStart=/usr/bin/python3 /opt/hapych-factory-voice/live_portal.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/hapych-factory-voice/private/portal
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
LockPersonality=true
MemoryMax=200M
CPUQuota=40%
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
